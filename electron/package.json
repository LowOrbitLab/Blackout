{
  "name": "blackout",
  "productName": "Blackout",
  "version": "1.0.0",
  "author": "LowOrbitLab",
  "homepage": "https://github.com/LowOrbitLab/Blackout",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "electron ./",
    "postinstall": "npx electron-rebuild",
    "build:mac": "electron-builder --mac --publish=never",
    "build:linux": "electron-builder --linux --publish=never",
    "build:windows": "electron-builder --win --publish=never"
  },
  "build": {
    "appId": "io.github.loworbitlab.blackout",
    "directories": {
      "output": "build",
      "buildResources": "resources"
    },
    "files": [
      "**/*",
      "resources/**/*"
    ],
    "artifactName": "${name}-${version}.${ext}",
    "mac": {
      "icon": "resources/icons/icon.png",
      "hardenedRuntime": true,
      "entitlements": "./resources/entitlements.mac.plist",
      "entitlementsInherit": "./resources/entitlements.mac.plist",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "resources/icons/icon.png"
    },
    "win": {
      "icon": "resources/icons/icon.png"
    }
  },
  "dependencies": {
    "@capacitor/electron": "^2.4.0",
    "electron-is-dev": "^1.2.0"
  },
  "devDependencies": {
    "electron": "^8.0.0",
    "electron-builder": "22.6.1",
    "electron-rebuild": "^1.11.0",
    "node-abi": "^2.18.0"
  },
  "description": "Offline cryptocurrency signing wallet",
  "repository": {
    "type": "git",
    "url": "https://github.com/LowOrbitLab/Blackout.git"
  }
}
